{
  "rules": {
    ".read": false,
    ".write": false,
    "site": {
      "content": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified == true",
        ".validate": "newData.hasChildren(['phone', 'whatsappMessage', 'pdfUrl', 'instagramUrl', 'mapsUrl', 'heroTitle', 'heroSubtitle', 'reservationTitle'])",
        "phone": {".validate": "newData.isString() && newData.val().length <= 40"},
        "whatsappMessage": {".validate": "newData.isString() && newData.val().length <= 300"},
        "pdfUrl": {".validate": "newData.isString() && newData.val().length <= 2000"},
        "pdfUrl1": {".validate": "newData.isString() && newData.val().length <= 2000"},
        "pdfCategory1": {".validate": "newData.isString() && newData.val().length <= 100"},
        "pdfUrl2": {".validate": "newData.isString() && newData.val().length <= 2000"},
        "pdfCategory2": {".validate": "newData.isString() && newData.val().length <= 100"},
        "instagramUrl": {".validate": "newData.isString() && newData.val().length <= 2000"},
        "mapsUrl": {".validate": "newData.isString() && newData.val().length <= 2000"},
        "heroTitle": {".validate": "newData.isString() && newData.val().length <= 300"},
        "heroSubtitle": {".validate": "newData.isString() && newData.val().length <= 300"},
        "reservationTitle": {".validate": "newData.isString() && newData.val().length <= 300"}
      }
    }
  }
}
